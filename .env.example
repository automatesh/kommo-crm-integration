# Google Sheets Configuration
GOOGLE_CREDENTIALS_PATH=./credentials/google_service_account.json
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SHEET_NAME=Orders

# Kommo CRM Configuration
KOMMO_SUBDOMAIN=kommocrmtest
KOMMO_ACCESS_TOKEN=your_long_lived_token_here
KOMMO_CLIENT_ID=98b2c0da-060d-41c6-9b45-d50e0b453ee7
KOMMO_CLIENT_SECRET=your_client_secret_here

# Telegram Bot (optional, for future use)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Sync Configuration
SYNC_INTERVAL_SECONDS=10
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/kommo-sync.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
